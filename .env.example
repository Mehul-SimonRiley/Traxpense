# Database Configuration
# Replace the value below with your actual production database URL to keep using the online database.
# If left empty or invalid, the app will fall back to a local SQLite database (backend/instance/expense_tracker.db).
DATABASE_URL=

# Security Keys (Defaults for local dev)
SECRET_KEY=dev-secret-key
JWT_SECRET_KEY=jwt-secret-key

# Email Settings (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Logging
LOG_LEVEL=INFO
